[Unit]
Description=Krempelair Bedien-Panel (Port 8080, nur LAN, Anmeldung mit Bot-Passwort)
After=network.target krempelair-control.service
StartLimitIntervalSec=0

[Service]
Type=simple
# schreibt Befehle und Einstellungen in die Datenbank wie der Bot; der
# Rückkanal zu maurizi.ch leitet Port 8080 nicht weiter
User=krempelair
Group=krempelair
WorkingDirectory=/opt/krempelair
Environment=PYTHONPATH=/opt/krempelair PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/krempelair/secrets.env
ExecStart=/usr/bin/python3 -m krempelair panel
Restart=always
RestartSec=5
StateDirectory=krempelair
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/krempelair
TasksMax=64
OOMScoreAdjust=900

[Install]
WantedBy=multi-user.target
